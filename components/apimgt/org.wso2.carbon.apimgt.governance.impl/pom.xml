    <profiles>
        <!--
            Puts a JDBC driver on the test classpath so SeverityColumnLiveDatabaseTest can run the severity
            detection and queries against a real database. Activated only when a driver is named, so an ordinary
            build never sees it.

            The driver is taken from a path rather than declared as a dependency, because Oracle ojdbc and IBM jcc
            are redistributed under the Oracle FUTC and IBM IPLA rather than an OSI licence and cannot be added to
            this repository. Naming a path works the same way for all six vendors and needs nothing downloaded.

            mvn test -Pgov-vendor-driver -Dtest=SeverityColumnLiveDatabaseTest \
                -Dgov.test.db.driverJar=$HOME/drivers/postgresql-42.7.4.jar \
                -Dgov.test.db.driver=org.postgresql.Driver \
                -Dgov.test.db.url=jdbc:postgresql://localhost:5432/govscratch \
                -Dgov.test.db.username=wso2carbon -Dgov.test.db.password=wso2carbon \
                -Dgov.test.db.disposable=true
        -->
        <profile>
            <id>gov-vendor-driver</id>
            <activation>
                <property>
                    <name>gov.test.db.driverJar</name>
                </property>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <additionalClasspathElements>
                                <additionalClasspathElement>${gov.test.db.driverJar}</additionalClasspathElement>
                            </additionalClasspathElements>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.felix</groupId>
                <artifactId>maven-bundle-plugin</artifactId>
                <extensions>true</extensions>
                <configuration>
                    <instructions>
                        <Bundle-SymbolicName>${project.artifactId}</Bundle-SymbolicName>
                        <Bundle-Name>${project.artifactId}</Bundle-Name>
                        <Private-Package>
                        </Private-Package>
                        <Export-Package>
                            org.wso2.carbon.apimgt.governance.impl.*;version="${carbon.apimgt.version}"
                        </Export-Package>
                        <Import-Package>
                            org.osgi.framework.*;version="${imp.package.version.osgi.framework}",
                            org.osgi.util.*;version="${imp.package.version.osgi.util}",
                            org.osgi.service.*;version="${imp.package.version.osgi.service}",
                            org.wso2.carbon.utils.*;version="${carbon.kernel.package.import.version.range}",
                            org.wso2.carbon.context.*;version="${carbon.kernel.package.import.version.range}",
                            *;resolution:=optional
                        </Import-Package>
                    </instructions>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-checkstyle-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>com.github.spotbugs</groupId>
                <artifactId>spotbugs-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

